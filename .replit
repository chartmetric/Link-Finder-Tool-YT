modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Artist campaign progress observer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "YouTube campaign progress observer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "YouTube v3 background sourcing"

[[workflows.workflow]]
name = "Artist campaign progress observer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run campaign:publish-progress --publish --campaign-id=full-tiers-1-5-no-ig-usd100 --queue-sha256=9d7abb7e11a718f465725115d46b678afeb50a114cba1efc61c921aab0364928 --watch"

[[workflows.workflow]]
name = "YouTube campaign progress observer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run youtube:publish-campaign --publish --run-id=full-tiers-1-5-no-youtube-uncapped --watch"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "YouTube v3 background sourcing"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node generated-artifacts/youtube-v3-unattended-20261118/supervisor.mjs"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "pkg-config"]
